# Copy this file to ".env" (no .example) and fill in ONE key.
# Lines starting with # are comments.

# Which brain to use: anthropic, gemini or ollama
BRAIN=anthropic

# --- Option A: Claude Haiku 5.5 (cheap, good at staying in character) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: how hard the plant thinks before answering (low, medium or high).
# Empty means the model's own normal amount.
ANTHROPIC_EFFORT=

# --- Option B: Google Gemini (has a free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: how hard the plant thinks before answering (minimal, low, medium or high).
# Empty means the model's own normal amount.
GEMINI_THINKING=

# --- Option C: a local model on your own machine (slow on a Raspberry Pi, free, private) ---
# Install Ollama, then run:  ollama pull gemma3:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Optional: if the main brain fails or today's budget is used up, use this one.
# (A good idea on a Raspberry Pi: FALLBACK_BRAIN=ollama)
FALLBACK_BRAIN=

# --- Wikipedia (off unless you turn it on) ---
# WIKIPEDIA=on lets your plant look things up on English Wikipedia, the only website it can ever use.
# The program fetches the article for it; the plant never touches the internet itself.
# WIKIPEDIA=off (or leaving this out) turns it off again. Restart the plant after changing it.
# A whole article is usually 5,000 to 20,000 tokens.
WIKIPEDIA=off
# Optional: a daily limit on lookups. Leave it empty for no limit (the daily token budget still applies).
WIKIPEDIA_DAILY_LIMIT=

# Extra room for thinking before the plant answers, in tokens, on top of its reply.
# If the Activity tab says "stopped because: max_tokens", raise this.
THINKING_ALLOWANCE=8000

# Safety caps per day (UTC). The plant rests when these are reached.
DAILY_CALL_BUDGET=150
# Reading a whole book uses about 90,000 tokens, so leave room for a few books a day.
# On Claude Haiku 5.5, 2,000,000 tokens a day costs at most about $0.20 (16p).
DAILY_TOKEN_BUDGET=2000000

# --- The web page ---
# Password for the chat page (at least 8 characters). Required for serve.py.
WEB_PASSWORD=
# 0.0.0.0 lets other devices on your Wi-Fi open it. Use 127.0.0.1 for this computer only.
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Quiet thoughts: how often (minutes) and which hours the plant is awake (24-hour clock, local time).
THINK_EVERY_MINUTES=60
AWAKE_START_HOUR=8
AWAKE_END_HOUR=22
